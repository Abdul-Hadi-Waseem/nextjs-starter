{
  "name": "nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Abdul Hadi Waseem",
    "url": "https://github.com/Abdul-Hadi-Waseem"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun run format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "analyze": "next analyze",
    "bundle:check": "node .github/bundle-budget.mjs",
    "images:check": "node .github/check-images.mjs",
    "prepare": "husky",
    "setup": "bun install && husky",
    "analyze:report": "next analyze --output"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@base-ui/utils": "0.5.0",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "kbar": "^1.0.0",
    "match-sorter": "^8.3.0",
    "motion": "^14.2.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.10.2",
    "postcss": "8.5.30",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.3",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "sharp": "^0.35.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint"
    ],
    "*.{css,json}": [
      "oxfmt --write"
    ]
  }
}
