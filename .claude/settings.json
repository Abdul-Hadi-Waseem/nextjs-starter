{
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run dev)",
      "Bash(bun run build)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run format)",
      "Bash(bun run format:check)",
      "Bash(bun run analyze:ci)",
      "Bash(bun run bundle:check)",
      "Bash(bun run images:check)",
      "Bash(bunx shadcn@latest add:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-on-stop.mjs"
          }
        ]
      }
    ]
  }
}
